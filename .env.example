# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- OTP login ---------------------------------------------------------------
# Login OTPs are delivered by, in order of precedence:
#   1. demo mode      NEXT_PUBLIC_DEMO_MODE=true (fixed 123456, shown on screen)
#   2. SMS provider   SMS_PROVIDER=... (our own OTP, sent by the provider below)
#   3. Firebase       Firebase Phone Authentication (default when the Firebase
#                     web config below is present; enable "Phone" under
#                     Authentication > Sign-in method and add your domain under
#                     Authorized domains in the Firebase console)
# Set NEXT_PUBLIC_AUTH_PROVIDER=none to disable Firebase login.
NEXT_PUBLIC_AUTH_PROVIDER=
#   SMS_PROVIDER=msg91    -> MSG91_AUTH_KEY, MSG91_TEMPLATE_ID (OTP template with ##OTP## variable)
#   SMS_PROVIDER=twilio   -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM (+1... or alphanumeric sender)
#   SMS_PROVIDER=webhook  -> SMS_WEBHOOK_URL (receives POST JSON {mobile, message, otp}), optional SMS_WEBHOOK_TOKEN
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Force demo OTP even when a provider is configured (staging only)
NEXT_PUBLIC_DEMO_MODE=

# --- PNR status (RapidAPI "IRCTC" by irctc1.p.rapidapi.com) -------------------
# With a key set, listings are auto-filled and verified against live PNR status.
RAPIDAPI_KEY=
# RAPIDAPI_IRCTC_HOST=irctc1.p.rapidapi.com

# Where the JSON data store lives (defaults to ./data/db.json locally, and the
# OS temp directory on serverless hosts such as Vercel, where it is NOT durable)
DATA_FILE=

# Durable storage for production (recommended on Vercel). Either pair works:
# Upstash Redis (Vercel Marketplace "Upstash" integration fills these in automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Firebase (Analytics + Phone Authentication) ------------------------------
# The web config is public; defaults for the seatexchange1207 project are built in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
