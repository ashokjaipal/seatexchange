# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- OTP login: MSG91 OTP Widget (recommended for India) ----------------------
# Widget ID and token auth are public (used by the browser); the Authkey is a secret
# used by the server to confirm each verification with MSG91.
NEXT_PUBLIC_MSG91_WIDGET_ID=366974674b4b343031343038
NEXT_PUBLIC_MSG91_TOKEN_AUTH=573164TMVdCX320G6aaf8d4dP1
MSG91_AUTH_KEY=
# Only if MSG91's verifyAccessToken response does not include the mobile number (insecure, avoid)
# MSG91_TRUST_CLIENT_MOBILE=false

# --- OTP login: other modes ------------------------------------------------------
# Login OTPs are delivered by, in order of precedence:
#   1. demo mode      NEXT_PUBLIC_DEMO_MODE=true (fixed 123456, shown on screen)
#   2. SMS provider   SMS_PROVIDER=... (our own OTP, sent by the provider below)
#   3. Firebase       Firebase Phone Authentication (default when the Firebase
#                     web config below is present; enable "Phone" under
#                     Authentication > Sign-in method and add your domain under
#                     Authorized domains in the Firebase console)
# Force a login mode: msg91 | firebase | sms | demo (default: first configured of msg91, sms, firebase, demo)
NEXT_PUBLIC_AUTH_PROVIDER=
#   SMS_PROVIDER=msg91    -> MSG91_AUTH_KEY, MSG91_TEMPLATE_ID (OTP template with ##OTP## variable)
#   SMS_PROVIDER=twilio   -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM (+1... or alphanumeric sender)
#   SMS_PROVIDER=webhook  -> SMS_WEBHOOK_URL (receives POST JSON {mobile, message, otp}), optional SMS_WEBHOOK_TOKEN
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Force demo OTP even when a provider is configured (staging only)
NEXT_PUBLIC_DEMO_MODE=

# --- PNR status (RapidAPI "IRCTC" by irctc1.p.rapidapi.com) -------------------
# With a key set, listings are auto-filled and verified against live PNR status.
RAPIDAPI_KEY=
# RAPIDAPI_IRCTC_HOST=irctc1.p.rapidapi.com

# Where the JSON data store lives (defaults to ./data/db.json locally, and the
# OS temp directory on serverless hosts such as Vercel, where it is NOT durable)
DATA_FILE=

# --- Backend: Cloud Firestore (recommended) -----------------------------------
# Service account JSON for project seatexchange-94e8b (raw JSON or base64).
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# Local alternative: path to that JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Local emulator (npx -y firebase-tools@latest emulators:start --only firestore)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# Skip demo users/listings on first start of an empty database
SEED_DEMO_DATA=true

# --- Alternative durable storage: Redis (used only when Firestore is not configured)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Firebase (Analytics + Phone Authentication) ------------------------------
# The web config is public; defaults for the seatexchange-94e8b project are built in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
