# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo mode: OTP is always 123456 and is shown on the login screen.
# Set to "false" once an SMS provider (MSG91 / Twilio / etc.) is wired in src/lib/otp.ts
NEXT_PUBLIC_DEMO_MODE=true

# Where the JSON data store lives (defaults to ./data/db.json)
DATA_FILE=
