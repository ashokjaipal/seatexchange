# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo mode: OTP is always 123456 and is shown on the login screen.
# Set to "false" once an SMS provider (MSG91 / Twilio / etc.) is wired in src/lib/otp.ts
NEXT_PUBLIC_DEMO_MODE=true

# Where the JSON data store lives (defaults to ./data/db.json locally, and the
# OS temp directory on serverless hosts such as Vercel, where it is NOT durable)
DATA_FILE=

# Durable storage for production (recommended on Vercel). Either pair works:
# Upstash Redis (Vercel Marketplace "Upstash" integration fills these in automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=
